# Secrets defined here are available for reference under registry/password, env/secret,
# builder/secrets, and accessories/*/env/secret in config/deploy.yml.
# All secrets are pulled from ENV or files — DO NOT enter raw credentials here.

# Docker Hub password (already exported in shell env by the deployer)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails master key — read from config/master.key if present, otherwise from env.
# config/master.key is gitignored; place it locally before deploying.
RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || echo "$RAILS_MASTER_KEY")

# Abort the deploy early if either secret would be empty.
: "${KAMAL_REGISTRY_PASSWORD:?KAMAL_REGISTRY_PASSWORD is empty — export it before kamal deploy}"
: "${RAILS_MASTER_KEY:?RAILS_MASTER_KEY is empty — place config/master.key or export RAILS_MASTER_KEY}"
