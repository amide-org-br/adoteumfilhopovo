# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/.keep

# Ignore storage (SQLite databases - created at runtime via Kamal volume).
/storage/*
!/storage/.keep

# Ignore assets (rebuilt during docker build).
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Ignore prayer_cards symlink target (mounted as a Kamal volume at runtime).
/prayer_cards
